# Optional shared server credential. Personal keys can instead be entered for one browser visit.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# openai uses OpenAI-hosted Whisper and needs no WHISPER_URL.
# For a separate server, choose speaches or raw and supply WHISPER_URL.
WHISPER_ENABLED=true
WHISPER_URL=
WHISPER_API_KEY=
WHISPER_API_STYLE=openai
WHISPER_MODEL=whisper-1
